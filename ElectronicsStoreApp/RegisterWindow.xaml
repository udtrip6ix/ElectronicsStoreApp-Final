<Window x:Class="WpfApp2.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Регистрация" Height="650" Width="500"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="Регистрация клиента" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <StackPanel Margin="0,5,0,0">
                <Label Content="ФИО"/>
                <TextBox Name="FullNameBox" Padding="10" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         materialDesign:HintAssist.Hint="Введите ваше ФИО"/>
                <TextBlock Name="FullNameError" Foreground="Red" FontSize="12"/>
            </StackPanel>

            <StackPanel Margin="0,5,0,0">
                <Label Content="Email"/>
                <TextBox Name="EmailBox" Padding="10" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         materialDesign:HintAssist.Hint="example@mail.ru"/>
                <TextBlock Name="EmailError" Foreground="Red" FontSize="12"/>
            </StackPanel>

            <StackPanel Margin="0,5,0,0">
                <Label Content="Номер телефона"/>
                <TextBox Name="PhoneBox" Padding="10" 
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                         materialDesign:HintAssist.Hint="+7XXXXXXXXXX"/>
                <TextBlock Name="PhoneError" Foreground="Red" FontSize="12"/>
            </StackPanel>

            <StackPanel Margin="0,5,0,0">
                <Label Content="Пароль"/>
                <PasswordBox Name="PasswordBox" Padding="10" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" 
                             materialDesign:HintAssist.Hint="Придумайте пароль"/>
                <TextBlock Name="PasswordError" Foreground="Red" FontSize="12"/>
            </StackPanel>

            <StackPanel Margin="0,5,0,0">
                <Label Content="Повторите пароль"/>
                <PasswordBox Name="PasswordRepeatBox" Padding="10" 
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" 
                             materialDesign:HintAssist.Hint="Повторите пароль"/>
                <TextBlock Name="RepeatError" Foreground="Red" FontSize="12"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Зарегистрироваться" Padding="20,8" Margin="5" Click="RegisterClick"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                <Button Content="Отмена" Padding="20,8" Margin="5" Click="CancelClick"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>